{
  "name": "icydry-server",
  "version": "1.0.0",
  "description": "IcyDry Smart Solar Dryer Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seedData.js",
    "ml:setup": "cd ../ml && python setup.bat",
    "ml:train": "cd ../ml && python run_pipeline.py",
    "ml:serve": "cd ../ml/api && python main.py",
    "ml:simulate": "cd ../ml && python simulator.py"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
